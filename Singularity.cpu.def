Bootstrap: docker
From: python:3.14-slim

%labels
    Maintainer FSAE RAG Pipeline Team
    Version 1.0.0-cpu
    Description Singularity container recipe for CPU-only document ingestion, LanceDB indexing, and Ollama LLM inference. Use on clusters with no GPU allocation; pair with `python -m src.hpc --cpu`.

%environment
    export OLLAMA_HOST=127.0.0.1:11434
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/usr/local/bin:$PATH

%setup
    # HPC sites (e.g. Vanda) inject bind paths -- often a LIST of them -- into
    # EVERY Apptainer invocation via apptainer.conf's "bind path =" directives
    # and/or APPTAINER_BIND/SINGULARITY_BIND env vars. This includes `build`,
    # where %post runs under --writable. Under --writable a bind to a path that
    # is absent from the base image is fatal ("destination /X doesn't exist in
    # container"); Apptainer refuses to auto-create it and %post never runs.
    # APPTAINER_NO_MOUNT=bind does NOT suppress these on all versions (this site
    # logs "Ignoring unknown mount type 'bind'"), so the robust fix is to
    # PRE-CREATE every site bind destination in the rootfs here, in %setup,
    # which runs against the host rootfs BEFORE any bind is applied. We stay
    # strictly POSIX sh because Apptainer may run %setup via /bin/sh (dash).
    ROOTFS="${SINGULARITY_ROOTFS}"
    # Gather all bind specs (comma-joined) from *_BIND env vars and the
    # "bind path" directives in apptainer/singularity site configs. A spec is
    # "src[:dst[:opt]]" in env vars, or a bare path in conf files.
    BINDS="${APPTAINER_BIND:-},${SINGULARITY_BIND:-}"
    # NB: keep the for-list on a SINGLE line -- dash (used as /bin/sh on the
    # HPC build host) mishandles a backslash-newline inside "for ... in".
    for conf in /etc/apptainer/apptainer.conf /etc/singularity/singularity.conf "${HOME}/.apptainer/apptainer.conf" "${HOME}/.singularity/singularity.conf"; do
        [ -f "$conf" ] || continue
        # "bind path = /x" or "bindpath = /x" -> "/x"; also handle the
        # "src:dst:opt" form if a site writes that on a bind path line.
        line_binds=$(sed -nE 's/^[[:space:]]*bind[[:space:]]*path[[:space:]]*=[[:space:]]*//Ip' "$conf" 2>/dev/null)
        [ -n "$line_binds" ] && BINDS="$BINDS,$(printf '%s\n' "$line_binds" | paste -sd, -)"
    done
    # Walk the comma list with IFS=','; whitespace inside a token is illegal for
    # mount paths, so strip it defensively.
    IFS_OLD=${IFS:-}; IFS=,
    set -- $BINDS
    IFS=$IFS_OLD
    for _tok in "$@"; do
        _tok=$(printf '%s' "$_tok" | tr -d '[:space:]')
        [ -n "$_tok" ] || continue
        # Split src[:dst[:opt]] on ':' using the parameter-expansion idiom.
        _rest=${_tok#*:}
        if [ "$_rest" = "$_tok" ]; then
            _dst=$_tok            # no colon -> src is the destination
        else
            _dst=${_rest%%:*}     # take the field right after the first colon
            [ -z "$_dst" ] && _dst=${_tok%%:*}
        fi
        case "$_dst" in
            /*) mkdir -p "$ROOTFS$_dst" 2>/dev/null || true ;;
        esac
    done
    unset _tok _rest _dst IFS_OLD

%post
    export DEBIAN_FRONTEND=noninteractive
    # NOTE: the base is python:3.14-slim, so Python 3.14 + pip ship in the image
    # already -- we do NOT apt-install python3/python3-pip (that would pull the
    # distro's 3.x and shadow 3.14). Two pinned deps (onnxruntime~=1.27.0,
    # numpy~=2.4.6) require Python >=3.11 and have NO cp310 wheel; building on
    # an ubuntu:22.04 base (Py 3.10) fails with "from versions: ... max 1.23.2".
    # build-essential is needed so pip can build any transitive dep that lacks a
    # cp314 wheel from source (3.14 is new).
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        poppler-utils \
        tesseract-ocr \
        curl \
        git \
        ca-certificates \
        zstd \
        && rm -rf /var/lib/apt/lists/*

    # Force the REAL public PyPI as the primary index. Some HPC build hosts sit
    # behind a stale pip mirror/proxy (PIP_INDEX_URL / /etc/pip.conf) that lags
    # PyPI by weeks. The torch wheel index is a SUPPLEMENT (--extra-index-url) so
    # PyPI stays the source of truth for every other pin. Upgrade pip first so
    # the resolver understands recent manylinux/cp314 wheel metadata.
    python3 -m pip install --upgrade "pip>=24.2" setuptools wheel \
        --index-url https://pypi.org/simple
    # CPU-only PyTorch wheels. Avoids pulling the multi-GB CUDA runtime the GPU
    # image (Singularity.def) requires, keeping this image small.
    pip install --no-cache-dir torch torchvision torchaudio \
        --index-url https://pypi.org/simple \
        --extra-index-url https://download.pytorch.org/whl/cpu

    pip install --no-cache-dir \
        "docling~=2.105.0" \
        "lancedb~=0.33.0" \
        "pylance~=7.0.0" \
        "ollama~=0.6.2" \
        "onnxruntime~=1.27.0" \
        "fastapi~=0.138.0" \
        "uvicorn[standard]~=0.49.0" \
        "pypdf~=6.14.0" \
        "numpy~=2.4.6" \
        "pydantic~=2.13.4" \
        "tqdm~=4.68.3" \
        "pyarrow~=24.0.0" \
        "portalocker~=3.2.0" \
        "requests~=2.34.2" \
        "urllib3~=2.5.0" \
        "pillow~=12.2.0" \
        "einops~=0.8.2" \
        "python-dotenv~=1.2.2"

    # Install Ollama. The install script extracts a .tar.zst, so zstd must be
    # present (apt-installed above). The fallback uses the current release asset
    # -- ollama-linux-amd64.tar.zst on GitHub releases; the old
    # ollama.com/download/ollama-linux-amd64.tar.gz 404s and was gzip, not zstd.
    curl -fsSL https://ollama.com/install.sh | sh || (
        curl -fsSL https://github.com/ollama/ollama/releases/latest/download/ollama-linux-amd64.tar.zst \
            | tar --zstd -xf - -C /usr/local
    )
    chmod +x /usr/local/bin/ollama || true

%runscript
    exec "$@"
