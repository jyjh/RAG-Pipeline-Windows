#!/bin/bash
#PBS -N rag_ingest_index
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -q gpu
#PBS -j oe

set -e

# Load Singularity module on NUS HPC
module load singularity

# Set scratch directory under /hpctmp2/${USER}/rag_scratch_${PBS_JOBID}
USER="${USER:-$(whoami)}"
PBS_JOBID="${PBS_JOBID:-local_job}"
SCRATCH_DIR="/hpctmp2/${USER}/rag_scratch_${PBS_JOBID}"
HOME="${HOME:-$(eval echo ~${USER})}"

# Ollama model store MUST live on shared storage visible to every compute node
# (NOT under the per-job scratch, which is wiped on exit). The default is the
# home directory; override OLLAMA_MODELS_DIR to point it at shared /hpctmp2
# space if your home has a tight quota. Models survive across jobs only if this
# path persists.
OLLAMA_MODELS_DIR="${OLLAMA_MODELS_DIR:-${HOME}/ollama_models}"

# Ensure scratch directory exists
mkdir -p "${SCRATCH_DIR}"
mkdir -p "${SCRATCH_DIR}/tmp"
mkdir -p "${OLLAMA_MODELS_DIR}"

# Cleanup trap for scratch directory and background processes.
# NOTE: ${OLLAMA_MODELS_DIR} is intentionally NOT removed here -- it holds the
# (multi-GB) model registry that is reused across jobs.
OLLAMA_PID=""
cleanup() {
    echo "Stopping background services and cleaning up scratch directory..."
    if [ -n "${OLLAMA_PID}" ]; then
        kill -9 "${OLLAMA_PID}" 2>/dev/null || true
    fi
    rm -rf "${SCRATCH_DIR}"
    echo "Cleanup complete."
}
trap cleanup EXIT

# Container SIF image location
CONTAINER_SIF="${CONTAINER_SIF:-rag_pipeline.sif}"
if [ ! -f "${CONTAINER_SIF}" ] && [ -f "/hpctmp2/${USER}/rag_pipeline.sif" ]; then
    CONTAINER_SIF="/hpctmp2/${USER}/rag_pipeline.sif"
fi

# Set bind mounts for HPC storage access. Bind both the scratch tree and the
# persistent model store (which may be ${HOME} or a custom dir) so the
# containerized Ollama can write to OLLAMA_MODELS.
BIND_MOUNTS="-B /hpctmp2/${USER}:/hpctmp2/${USER} -B ${HOME}:/srv/home -B ${PWD}:/app -B ${OLLAMA_MODELS_DIR}:/srv/ollama_models"

# Configure Ollama models (persistent) and temp paths (high-speed scratch).
export OLLAMA_MODELS="/srv/ollama_models"
export TMPDIR="${SCRATCH_DIR}/tmp"

echo "========================================================"
echo "NUS HPC RAG Bulk Ingest & Index Job"
echo "Job ID: ${PBS_JOBID}"
echo "User: ${USER}"
echo "Scratch Directory: ${SCRATCH_DIR}"
echo "Ollama Models (persistent): ${OLLAMA_MODELS_DIR} -> /srv/ollama_models"
echo "Container SIF: ${CONTAINER_SIF}"
echo "Working Directory: ${PWD}"
echo "========================================================"

# Start background Ollama daemon inside container
echo "Starting background Ollama daemon inside container..."
singularity exec --nv ${BIND_MOUNTS} "${CONTAINER_SIF}" ollama serve > "${SCRATCH_DIR}/ollama.log" 2>&1 &
OLLAMA_PID=$!

# Await endpoint readiness (/api/version)
echo "Awaiting Ollama API endpoint readiness (http://127.0.0.1:11434/api/version)..."
MAX_ATTEMPTS=30
ATTEMPT=0
READY=0

while [ ${ATTEMPT} -lt ${MAX_ATTEMPTS} ]; do
    if singularity exec ${BIND_MOUNTS} "${CONTAINER_SIF}" curl -s -f http://127.0.0.1:11434/api/version > /dev/null 2>&1; then
        READY=1
        echo "Ollama daemon API endpoint is online and responsive!"
        break
    fi
    ATTEMPT=$((ATTEMPT + 1))
    sleep 2
done

if [ ${READY} -ne 1 ]; then
    echo "ERROR: Ollama endpoint failed to become ready within timeout."
    echo "--- Ollama Log Output ---"
    cat "${SCRATCH_DIR}/ollama.log" || true
    exit 1
fi

# Pre-pull the models the pipeline depends on so the registry is warm BEFORE
# ingestion/indexing starts. A bogus tag fails loudly here instead of surfacing
# as a 404 deep in the embedding loop. Override the list with
# OLLAMA_MODELS_TO_PULL (space-separated, must match config.toml [models]/*).
DEFAULT_MODELS="nomic-embed-text qwen2.5vl:7b gemma4 qwen2.5:1.5b"
OLLAMA_MODELS_TO_PULL="${OLLAMA_MODELS_TO_PULL:-${DEFAULT_MODELS}}"
echo "Pre-pulling Ollama models: ${OLLAMA_MODELS_TO_PULL}"
PULL_FAIL=0
for model in ${OLLAMA_MODELS_TO_PULL}; do
    echo "--- ollama pull ${model} ---"
    if ! singularity exec ${BIND_MOUNTS} "${CONTAINER_SIF}" ollama pull "${model}"; then
        echo "ERROR: ollama pull failed for '${model}' -- aborting before the pipeline starts."
        echo "Check the tag against config.toml; a common gotcha is a custom alias (e.g. 'gemma4')"
        echo "that has not yet been created with 'ollama create' on this model store."
        PULL_FAIL=1
    fi
done
if [ ${PULL_FAIL} -ne 0 ]; then
    exit 1
fi

# Execute document ingestion and indexing pipeline
echo "Starting bulk document ingestion and indexing..."
INPUT_DATA_DIR="${INPUT_DATA_DIR:-data}"

singularity exec --nv ${BIND_MOUNTS} "${CONTAINER_SIF}" python3 scripts/bulk_ingest.py --input-dir "${INPUT_DATA_DIR}"

echo "Bulk document ingestion and indexing job finished successfully."
