#!/bin/bash
# DEPRECATED: LLM serving now runs on the hosted SoCLAaS API ([llm_api] in
# config.toml), so this long-lived Ollama GPU serving job + SSH tunnel flow is
# obsolete. This file is retained for reference/revert; the setup wizard no
# longer submits it. Do not use in new deployments.
#PBS -N rag_ollama_serve
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -q gpu
#PBS -j oe

# ==============================================================================
# Long-lived Ollama serving job for interactive chat.
#
# Unlike nus_hpc_ingest_index.pbs (which builds the index and exits), this job
# keeps `ollama serve` alive on a GPU compute node until its walltime expires
# or PBS deletes it. It publishes the allocated compute-node hostname to a
# discovery file on shared storage so the SSH tunnel daemon
# (scripts/tunnel_daemon.{sh,ps1}) can find it and forward 127.0.0.1:11434 to
# the node -- enabling the laptop-hosted web app to use the cluster GPU.
#
# Tunables (env, set on qsub with -v or in your shell):
#   OLLAMA_MODELS_DIR      persistent model store (default ${HOME}/ollama_models)
#   OLLAMA_HOST_FILE       discovery file the tunnel reads (default
#                          ${HOME}/.rag_ollama_serving_host)
#   OLLAMA_MODELS_TO_PULL  space-separated tags to pre-pull (default the 4 the
#                          pipeline uses: nomic-embed-text qwen2.5vl:7b gemma4
#                          qwen2.5:1.5b)
# ==============================================================================

set -e

module load singularity

USER="${USER:-$(whoami)}"
PBS_JOBID="${PBS_JOBID:-local_job}"
HOME="${HOME:-$(eval echo ~${USER})}"

SCRATCH_DIR="/scratch/${USER}/rag_serve_scratch_${PBS_JOBID}"
OLLAMA_MODELS_DIR="${OLLAMA_MODELS_DIR:-${HOME}/ollama_models}"
OLLAMA_HOST_FILE="${OLLAMA_HOST_FILE:-${HOME}/.rag_ollama_serving_host}"

mkdir -p "${SCRATCH_DIR}/tmp"
mkdir -p "${OLLAMA_MODELS_DIR}"

# Resolve the compute node's hostname and publish it for the tunnel daemon.
# This node is on the cluster's private network; the tunnel reaches it via the
# login/jump host with ssh ProxyJump.
COMPUTE_HOST="$(hostname -f 2>/dev/null || hostname)"
echo "${COMPUTE_HOST}" > "${OLLAMA_HOST_FILE}"
echo "[$(date)] Published serving compute host '${COMPUTE_HOST}' to ${OLLAMA_HOST_FILE}"

# Cleanup: stop Ollama and remove the discovery file so the tunnel does not
# keep trying a dead node. Model store is persistent and NOT removed.
OLLAMA_PID=""
cleanup() {
    echo "[$(date)] Stopping serving job (PBS_JOBID=${PBS_JOBID})..."
    if [ -n "${OLLAMA_PID}" ]; then
        kill -9 "${OLLAMA_PID}" 2>/dev/null || true
    fi
    rm -f "${OLLAMA_HOST_FILE}"
    rm -rf "${SCRATCH_DIR}"
    echo "[$(date)] Cleanup complete."
}
trap cleanup EXIT

CONTAINER_SIF="${CONTAINER_SIF:-rag_pipeline.sif}"
if [ ! -f "${CONTAINER_SIF}" ] && [ -f "/scratch/${USER}/rag_pipeline.sif" ]; then
    CONTAINER_SIF="/scratch/${USER}/rag_pipeline.sif"
fi

BIND_MOUNTS="-B /scratch/${USER}:/scratch/${USER} -B ${HOME}:/srv/home -B ${PWD}:/app -B ${OLLAMA_MODELS_DIR}:/srv/ollama_models"

export OLLAMA_MODELS="/srv/ollama_models"
export TMPDIR="${SCRATCH_DIR}/tmp"

echo "========================================================"
echo "NUS HPC RAG Ollama Serving Job"
echo "Job ID: ${PBS_JOBID}"
echo "Compute Host: ${COMPUTE_HOST}"
echo "Discovery File: ${OLLAMA_HOST_FILE}"
echo "Ollama Models (persistent): ${OLLAMA_MODELS_DIR} -> /srv/ollama_models"
echo "Container SIF: ${CONTAINER_SIF}"
echo "========================================================"

echo "Starting background Ollama daemon inside container..."
singularity exec --nv ${BIND_MOUNTS} "${CONTAINER_SIF}" ollama serve > "${SCRATCH_DIR}/ollama.log" 2>&1 &
OLLAMA_PID=$!

# Await endpoint readiness
MAX_ATTEMPTS=30
ATTEMPT=0
READY=0
while [ ${ATTEMPT} -lt ${MAX_ATTEMPTS} ]; do
    if singularity exec ${BIND_MOUNTS} "${CONTAINER_SIF}" curl -s -f http://127.0.0.1:11434/api/version > /dev/null 2>&1; then
        READY=1
        echo "Ollama API endpoint online at http://127.0.0.1:11434"
        break
    fi
    ATTEMPT=$((ATTEMPT + 1))
    sleep 2
done
if [ ${READY} -ne 1 ]; then
    echo "ERROR: Ollama endpoint failed to become ready within timeout."
    cat "${SCRATCH_DIR}/ollama.log" || true
    exit 1
fi

# Pre-pull so the first chat request is not delayed. Non-fatal on failure here
# (serving can still satisfy requests for already-present models), unlike the
# ingest job which must abort on a missing model.
DEFAULT_MODELS="nomic-embed-text qwen2.5vl:7b gemma4 qwen2.5:1.5b"
OLLAMA_MODELS_TO_PULL="${OLLAMA_MODELS_TO_PULL:-${DEFAULT_MODELS}}"
echo "Pre-pulling models: ${OLLAMA_MODELS_TO_PULL}"
for model in ${OLLAMA_MODELS_TO_PULL}; do
    echo "--- ollama pull ${model} ---"
    singularity exec ${BIND_MOUNTS} "${CONTAINER_SIF}" ollama pull "${model}" || \
        echo "WARNING: pull failed for '${model}' (continuing; it may already be present)"
done

# Block until walltime/PBS kills us. The 15s tick both keeps the job's stdout
# alive (useful in qstat -f / tracejob) and re-publishes the discovery file in
# case shared storage flapped.
echo "[$(date)] Serving. Forward 127.0.0.1:11434 here via the tunnel daemon."
KEEPALIVE_INTERVAL=15
START_EPOCH="$(date +%s)"
while true; do
    sleep "${KEEPALIVE_INTERVAL}"
    echo "${COMPUTE_HOST}" > "${OLLAMA_HOST_FILE}"
    NOW_EPOCH="$(date +%s)"
    ELAPSED=$(( (NOW_EPOCH - START_EPOCH) / 60 ))
    echo "[$(date)] alive: ollama serving on ${COMPUTE_HOST} (uptime ~${ELAPSED} min, pid ${OLLAMA_PID})"
done
